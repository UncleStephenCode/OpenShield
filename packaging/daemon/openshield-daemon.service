[Unit]
Description=OpenShield host firewall daemon
Documentation=https://github.com/UncleStephenCode/openshield
After=local-fs.target systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service
RequiresMountsFor=/run/openshield /var/lib/openshield
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
SupplementaryGroups=openshield
ExecStartPre=/usr/bin/openshield-daemon --install-fail-closed
ExecStart=/usr/bin/openshield-daemon
# The daemon performs the same non-persistent quarantine during graceful
# shutdown. This is the backup for crashes and forced termination; it runs only
# after the main process released the singleton lock.
ExecStopPost=/usr/bin/openshield-daemon --install-fail-closed
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillMode=mixed

# CAP_NET_ADMIN manages policy. CAP_NET_RAW lets legacy xtables open the raw
# IPv4/IPv6 sockets required for alternate-backend inspection and fallback.
# CAP_SYS_PTRACE and read/search-only DAC bypass are required solely to bind a
# queued socket inode to /proc/<pid>/{fd,exe,cmdline,cgroup,status}. Selected
# direct inspection syscalls are denied below, but this is not process-memory
# isolation; see docs/THREAT_MODEL.md.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
UMask=0077

# Filesystem and kernel hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# The nested netfilter/nfnetlink_queue entry is required for reply scheduling.
# subset=pid hides it even via /proc/self/net. Keep procfs read-only instead;
# process visibility, kernel tunable protection and capabilities stay restricted.
ProcSubset=all
ReadOnlyPaths=/proc
# openshield.conf pre-creates all three paths as root:root and restores their
# policy-defined SELinux labels. Do not use RuntimeDirectory= or StateDirectory=:
# their ownership repair is recursive and can be denied on preserved LSM-labelled
# files. Keeping the standard lock lets old and new xtables processes serialize.
ReadWritePaths=/run/openshield /var/lib/openshield /run/xtables.lock

# Runtime attack-surface reduction. nft/NFQUEUE use AF_NETLINK; the legacy
# iptables fallback probes and updates IPv4/IPv6 filter tables through the
# corresponding socket families.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallFilter=~ptrace process_vm_readv process_vm_writev kcmp pidfd_getfd open_by_handle_at
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
# When enabled with systemctl, make network-pre.target require the firewall's
# successful ordered startup. Network managers that bypass network-pre.target
# still need a distribution-specific dependency or initramfs policy.
RequiredBy=network-pre.target
